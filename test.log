  ["brgen"]="brgen.no oshlo.no trndheim.no stvanger.no trmso.no reykjavk.is kobenhvn.dk stholm.se gteborg.se mlmoe.se hlsinki.fi lndon.uk mnchester.uk brmingham.uk edinbrgh.uk glasgw.uk lverpool.uk amstrdam.nl rottrdam.nl utrcht.nl brssels.be zrich.ch lchtenstein.li frankfrt.de mrseille.fr mlan.it lsbon.pt lsangeles.com newyrk.us chcago.us dtroit.us houstn.us dllas.us austn.us prtland.com mnneapolis.com"
  ["pubattorney"]="pub.attorney freehelp.legal"
  ["bsdports"]="bsdports.org"
  ["hjerterom"]="hjerterom.no"
  ["privcam"]="privcam.no"
  ["amber"]="amberapp.com"
  ["blognet"]="foodielicio.us stacyspassion.com antibettingblog.com anticasinoblog.com antigamblingblog.com foball.no"
)

log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
}

log "Installing system packages..."
doas pkg_add -U ruby-3.3 postgresql-server redis node falcon

log "Setting up PostgreSQL..."
if [ ! -d /var/postgresql/data ]; then
  doas install -d -o _postgresql -g _postgresql /var/postgresql/data
  doas -u _postgresql initdb -D /var/postgresql/data -U postgres -A scram-sha-256 -E UTF8
fi

doas rcctl enable postgresql
doas rcctl start postgresql

log "Setting up pf firewall..."
doas tee /etc/pf.conf > /dev/null << EOF
ext_if = "vio0"
set skip on lo
table <bruteforce> persist
set block-policy return
scrub in all
block log all
pass out quick on \$ext_if all
pass in on \$ext_if proto tcp to port 22 keep state (max-src-conn 5, max-src-conn-rate 5/60, overload <bruteforce> flush global)
pass in on \$ext_if proto tcp to port { 80, 443 } keep state
pass in on \$ext_if proto { tcp, udp } to port 53 keep state
pass inet proto icmp all icmp-type { echoreq, unreach, timex, paramprob }
anchor "relayd/*"
EOF

doas pfctl -f /etc/pf.conf
doas rcctl enable pf

log "Setting up ACME client..."
doas mkdir -p /var/www/acme /etc/acme
doas chown -R www:www /var/www/acme

if [ ! -f /etc/acme/letsencrypt-privkey.pem ]; then
  doas openssl ecparam -name prime256v1 -genkey -out /etc/acme/letsencrypt-privkey.pem
fi

cat > /tmp/acme-client.conf << EOF
authority letsencrypt {
  api url "https://acme-v02.api.letsencrypt.org/directory"
  account key "/etc/acme/letsencrypt-privkey.pem"
}
EOF

for domain in "${(@k)all_domains}"; do
  subdomains="${all_domains[$domain]}"
  alt_names=""
  if [[ -n "$subdomains" ]]; then
    for sub in ${(s/ /)subdomains}; do
      alt_names+="$sub.$domain "
    done
    alt_names=${alt_names% }
  fi

  cat >> /tmp/acme-client.conf << EOF

domain "$domain" {
  domain key "/etc/ssl/private/$domain.key"
  domain fullchain certificate "/etc/ssl/$domain.fullchain.pem"
  domain certificate "/etc/ssl/$domain.crt"
  sign with letsencrypt
  challengedir "/var/www/acme"
EOF
  
  if [[ -n "$alt_names" ]]; then
    echo "  alternative names { $(echo $alt_names | sed 's/ /", "/g') }" >> /tmp/acme-client.conf
  fi
  
  echo "}" >> /tmp/acme-client.conf
done

doas mv /tmp/acme-client.conf /etc/acme-client.conf

log "Setting up httpd for ACME challenges..."
doas tee /etc/httpd.conf > /dev/null << EOF
types { include "/usr/share/misc/mime.types" }

server "acme" {
  listen on * port 80
  root "/var/www/acme"
  location "/.well-known/acme-challenge/*" {
    root "/acme"
    request strip 2
  }
}
EOF

doas rcctl enable httpd
doas rcctl start httpd

log "Setting up NSD DNS server..."
doas mkdir -p /var/nsd/zones/master /etc/nsd

for domain in "${(@k)all_domains}"; do
  serial=$(date +"%Y%m%d%H")
  
  doas tee "/var/nsd/zones/master/$domain.zone" > /dev/null << EOF
\$ORIGIN $domain.
\$TTL 24h

@ IN SOA ns.brgen.no. admin.brgen.no. ($serial 1h 15m 1w 3m)
@ IN NS ns.brgen.no.
@ IN NS ns.$backup_ns.

@ IN A $main_ip
www IN CNAME @
EOF

  if [[ "$domain" == "brgen.no" ]]; then
    echo "ns IN A $main_ip" | doas tee -a "/var/nsd/zones/master/$domain.zone" > /dev/null
  fi

  subdomains="${all_domains[$domain]}"
  if [[ -n "$subdomains" ]]; then
    for sub in ${(s/ /)subdomains}; do
      echo "$sub IN A $main_ip" | doas tee -a "/var/nsd/zones/master/$domain.zone" > /dev/null
    done
  fi
done

doas tee /etc/nsd/nsd.conf > /dev/null << EOF
server:
  ip-address: 0.0.0.0
  hide-version: yes
  zonesdir: "/var/nsd/zones"

remote-control:
  control-enable: yes

EOF

for domain in "${(@k)all_domains}"; do
  cat >> /tmp/nsd_zones.conf << EOF
zone:
  name: "$domain"
  zonefile: "master/$domain.zone"
  provide-xfr: $backup_ns NOKEY
  notify: $backup_ns NOKEY

EOF
done

doas tee -a /etc/nsd/nsd.conf < /tmp/nsd_zones.conf > /dev/null
rm /tmp/nsd_zones.conf

doas rcctl enable nsd
doas rcctl start nsd

log "Obtaining SSL certificates..."
for domain in "${(@k)all_domains}"; do
  log "Getting certificate for $domain..."
  if ! doas timeout 120 acme-client -v "$domain"; then
    log "Warning: Certificate request failed for $domain, continuing..."
  fi
done

log "Setting up application users and directories..."
for app in "${(@k)app_ports}"; do
  if ! id "$app" >/dev/null 2>&1; then
    doas useradd -m -G www -s /bin/ksh "$app"
  fi
  
  app_dir="/home/$app/app"
  doas mkdir -p "$app_dir"/{public,config,log,tmp}
  
  db_pass=$(openssl rand -hex 16)
  
  doas -u _postgresql psql -U postgres -c "CREATE ROLE ${app}_user LOGIN PASSWORD '$db_pass';" || true
  doas -u _postgresql createdb -O "${app}_user" "${app}_production" || true
  
  cat > "/tmp/${app}_env" << EOF
RAILS_ENV=production
SECRET_KEY_BASE=$(openssl rand -hex 64)
DATABASE_URL=postgresql://${app}_user:$db_pass@localhost/${app}_production
REDIS_URL=redis://localhost:6379/0
EOF
  
  doas mv "/tmp/${app}_env" "$app_dir/.env"
  doas chown "$app:www" "$app_dir/.env"
  doas chmod 600 "$app_dir/.env"
  
  doas tee "$app_dir/config.ru" > /dev/null << EOF
require 'bundler/setup'
require 'rails'
require 'dotenv/load'

run lambda { |env|
  [200, {'Content-Type' => 'text/html'}, ["<h1>$app app running</h1>"]]
}
EOF

  port="${app_ports[$app]}"
  
  doas tee "/etc/rc.d/$app" > /dev/null << EOF
#!/bin/ksh

daemon_user="$app"
daemon_class="daemon"
daemon_execdir="$app_dir"
daemon_flags="serve --bind http://127.0.0.1:$port --config $app_dir/config.ru"
daemon="/usr/local/bin/falcon"

. /etc/rc.d/rc.subr

rc_bg=YES
rc_usercheck=YES

rc_start() {
    rc_exec "cd \$daemon_execdir && source .env && \$daemon \$daemon_flags"
}

rc_cmd \$1
EOF

  doas chmod +x "/etc/rc.d/$app"
  doas chown -R "$app:www" "$app_dir"
  
  doas rcctl enable "$app"
  doas rcctl start "$app"
done

log "Configuring relayd load balancer..."
cat > /tmp/relayd.conf << EOF
table <httpd> { 127.0.0.1:80 }

http protocol "http_redirect" {
  match request header set "X-Forwarded-For" value "\$REMOTE_ADDR"
  pass request path "/.well-known/acme-challenge/*" forward to <httpd>
  match request header "Host" tag "redirect"
  match request tagged "redirect" header set "Location" value "https://\$HTTP_HOST\$REQUEST_URI"
  match request tagged "redirect" return code 301
}

relay "http" {
  listen on $main_ip port 80
  protocol "http_redirect"
  forward to <httpd> port 80
}

http protocol "https_secure" {
  match request header set "X-Forwarded-For" value "\$REMOTE_ADDR"
  match request header set "X-Forwarded-Proto" value "https"
  match response header set "Strict-Transport-Security" value "max-age=31536000; includeSubDomains"
  match response header set "X-Content-Type-Options" value "nosniff"
  match response header set "X-Frame-Options" value "DENY"
  match response header set "X-XSS-Protection" value "1; mode=block"
  http websockets
}

EOF

for app in "${(@k)app_ports}"; do
  port="${app_ports[$app]}"
  echo "table <${app}_backend> { 127.0.0.1:$port }" >> /tmp/relayd.conf
done

for domain in "${(@k)all_domains}"; do
  echo "" >> /tmp/relayd.conf
  echo "tls keypair \"$domain\" {" >> /tmp/relayd.conf
  echo "  certificate \"/etc/ssl/$domain.crt\"" >> /tmp/relayd.conf
  echo "  key \"/etc/ssl/private/$domain.key\"" >> /tmp/relayd.conf
  echo "}" >> /tmp/relayd.conf
done

echo "" >> /tmp/relayd.conf
echo "relay \"https\" {" >> /tmp/relayd.conf
echo "  listen on $main_ip port 443 tls" >> /tmp/relayd.conf
echo "  protocol \"https_secure\"" >> /tmp/relayd.conf

for app in "${(@k)app_domains}"; do
  domains="${app_domains[$app]}"
  for domain in ${(s/ /)domains}; do
    echo "  match request header \"Host\" value \"$domain\" forward to <${app}_backend>" >> /tmp/relayd.conf
    subdomains="${all_domains[$domain]}"
    if [[ -n "$subdomains" ]]; then
      for sub in ${(s/ /)subdomains}; do
        echo "  match request header \"Host\" value \"$sub.$domain\" forward to <${app}_backend>" >> /tmp/relayd.conf
      done
    fi
  done
done

echo "}" >> /tmp/relayd.conf

if doas relayd -n -f /tmp/relayd.conf; then
  doas mv /tmp/relayd.conf /etc/relayd.conf
  doas rcctl enable relayd
  doas rcctl start relayd
else
  log "Error: Invalid relayd configuration"
  exit 1
fi

doas rcctl enable redis
doas rcctl start redis

log "Setup complete. OpenBSD server configured with:"
for app in "${(@k)app_ports}"; do
  port="${app_ports[$app]}"
  domains="${app_domains[$app]}"
  log "  $app (port $port): $domains"
done
