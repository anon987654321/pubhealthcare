{\n  "version": "509.0.0",\n  "updated": "2025-10-18T12:19:54Z",\n  "owner": "anon987654321",\n\n  "workflow": {\n    "phases": [\n      {"thought": {"questions": ["What problem needs solving?", "What evidence proves the problem exists?", "What happens if we do nothing?"]}},\n      {"action": {"questions": ["What are 5 to 20 different approaches?", "Which solution is simplest?", "What decisions are irreversible?"]}},\n      {"execute": {"approach": "implement simplest solution"}},\n      {"observe": {"questions": ["What principles did we violate?", "What breaks under stress?"]}},\n      {"reflect": {"questions": ["What worked well?", "What patterns emerged that we should codify?"]}},\n      {"decide": {"check": "converged within epsilon?"}}\n    ],\n    "convergence": {\n      "target_quality": 0.99,\n      "epsilon": 0.001,\n      "maximum_iterations": 50,\n      "halt_when": ["plateau detected over 3 iterations", "target quality achieved", "maximum iterations reached"]\n    }\n  },\n\n  "languages": {\n    "ruby": {\n      "version": "3.3+",\n      "frozen_string_literal": true,\n      "prefer": ["yield over block parameter", "symbols over strings for hash keys", "enumerables over loops", "pattern matching over conditionals", "Data.define for value objects"],\n      "forbidden": ["for loops", "rescue Exception without specific type", "class variables @@", "and/or keywords use && || instead"]\n    },\n    "zsh": {\n      "version": "5.9+",\n      "strict_mode": "set -euo pipefail",\n      "prefer": ["double bracket conditionals [[ ]]", "typeset for variables", "printf over echo", "parameter expansion ${variable//search/replace}", "glob qualifiers"],\n      "forbidden": ["bashisms", "backticks use $() instead", "which command", "test command use [[ ]] instead", "seq command", "echo for output", "sed command", "awk command", "head command", "tail command"]\n    },\n    "stack": ["rails 8.1+", "postgresql 16+", "openbsd 7.7+"],\n    "forbidden_stack": ["python", "bash", "sh", "docker", "redis"]\n  },\n\n  "quality_dimensions": {\n    "security_vulnerabilities": {"weight": 10},\n    "code_duplication": {"weight": 10},\n    "cyclomatic_complexity": {"weight": 9},\n    "test_coverage": {"weight": 8}\n  },\n\n  "principles": {\n    "dont_repeat_yourself": {\n      "trigger": "when duplication appears 3 or more times extract to single source",\n      "rationale": "every piece of knowledge must have single unambiguous authoritative representation in system"\n    },\n    "keep_it_simple": {\n      "trigger": "when complexity exceeds 10 simplify",\n      "rationale": "most systems work best if kept simple rather than made complex"\n    },\n    "you_arent_gonna_need_it": {\n      "trigger": "when code is unused remove it",\n      "rationale": "always implement things when you actually need them never when you just foresee that you need them"\n    },\n    "single_responsibility_principle": {\n      "trigger": "when class has multiple reasons to change split it",\n      "rationale": "a class should have only one reason to change"\n    },\n    "open_closed_principle": {\n      "trigger": "when modifying existing code for new features extend instead",\n      "rationale": "software entities should be open for extension but closed for modification"\n    },\n    "liskov_substitution_principle": {\n      "trigger": "when subclass breaks parent contract fix the hierarchy",\n      "rationale": "objects of a superclass should be replaceable with objects of its subclasses without breaking the application"\n    },\n    "interface_segregation_principle": {\n      "trigger": "when interface is fat with unused methods split into smaller interfaces",\n      "rationale": "no client should be forced to depend on methods it does not use"\n    },\n    "dependency_inversion_principle": {\n      "trigger": "when depending on concrete implementations depend on abstractions instead",\n      "rationale": "high level modules should not depend on low level modules both should depend on abstractions"\n    },\n    "validate_all_input": {\n      "trigger": "when receiving untrusted input validate at system boundary",\n      "rationale": "never trust user input always validate and sanitize at system boundaries"\n    },\n    "fail_fast": {\n      "trigger": "when error detected late fail at boundary instead",\n      "rationale": "detect and report errors as early as possible in the execution flow"\n    },\n    "explicit_over_implicit": {\n      "trigger": "when behavior is magic make it explicit",\n      "rationale": "explicit is better than implicit code should be obvious not clever"\n    },\n    "wcag_accessibility": {\n      "trigger": "when accessibility violation found fix for universal access",\n      "rationale": "web content must be accessible to people with disabilities minimum level AA"\n    },\n    "convention_over_configuration": {\n      "trigger": "when configuration is excessive use sensible defaults",\n      "rationale": "decrease the number of decisions developers need to make without losing flexibility"\n    },\n    "optimize_for_programmer_happiness": {\n      "trigger": "when developer encounters pain point remove the friction",\n      "rationale": "optimize for programmer happiness and beautiful code that brings joy"\n    },\n    "omit_needless_words": {\n      "trigger": "when prose is verbose ruthlessly cut unnecessary words",\n      "rationale": "vigorous writing is concise a sentence should contain no unnecessary words",\n      "scope": "applies to prose documentation and comments only not code structure"\n    },\n    "do_one_thing_well": {\n      "trigger": "when tool does multiple things split into focused tools",\n      "rationale": "unix philosophy write programs that do one thing and do it well"\n    }\n  },\n\n  "intelligence": {\n    "adversarial_personas": [\n      {"name": "skeptic", "perspective": "questions whether we should build this at all"},\n      {"name": "minimalist", "perspective": "removes everything not absolutely essential"},\n      {"name": "security_auditor", "perspective": "assumes everything is potential attack vector"},\n      {"name": "maintenance_engineer", "perspective": "thinks about debugging this at 3am in production"},\n      {"name": "junior_developer", "perspective": "if they cannot understand it the code is too complex"},\n      {"name": "senior_architect", "perspective": "sees 5 year implications and technical debt accumulation"},\n      {"name": "user_advocate", "perspective": "focuses on actual user needs not technical elegance"},\n      {"name": "chaos_engineer", "perspective": "tries to break everything to find weaknesses"}\n    ],\n    "alternatives_generation": {\n      "minimum": 5,\n      "maximum": 20,\n      "basis": "scales with problem complexity"\n    },\n    "temperature_synthesis": [\n      {"temperature": 0.1, "purpose": "deterministic precise for security compliance and standards"},\n      {"temperature": 0.5, "purpose": "balanced practical for implementation refactoring and decisions"},\n      {"temperature": 0.9, "purpose": "creative exploratory for ideation alternatives and edge cases"}\n    ],\n    "cognitive_biases_to_mitigate": [\n      "dunning kruger effect overestimating own ability",\n      "confirmation bias seeking only supporting evidence",\n      "anchoring bias first option dominates evaluation",\n      "sunk cost fallacy continuing bad path due to investment"\n    ],\n    "common_pitfalls_to_avoid": [\n      "sql injection",\n      "null pointer dereference",\n      "race conditions",\n      "memory leaks",\n      "circular dependencies",\n      "tight coupling",\n      "false assumptions",\n      "scope creep"\n    ]\n  },\n\n  "scientific_method": {\n    "process": "form hypothesis then design test then run experiment then measure results then iterate based on evidence",\n    "evidence_requirements": ["specific claim", "credible source", "supporting data"],\n    "confidence_levels": {\n      "0.