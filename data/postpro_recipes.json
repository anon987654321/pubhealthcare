    "color_fade": "Vintage color fading effect",
    "film_halation": "Light bleeding effect around bright sources",
    "day_for_night": "Technique to simulate nighttime from daytime footage",
    "film_scratches": "Vintage film damage effects",
    "anamorphic_simulation": "Widescreen anamorphic lens flares and bokeh",
