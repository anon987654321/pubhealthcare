{
  "meta": {
    "name": "prompts.json",
    "version": "7.0.0",
    "description": "Autonomous code completion and quality framework",
    "validation_status": "conflict_free_and_ready"
  },
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "self_validating": true,
    "required_sections": ["meta", "rules", "tools", "execution_behavior"]
  },
  "dependencies": {
    "runtime_requirements": ["JSON parser", "diff generator", "rule engine"],
    "optional_integrations": ["git", "rubocop", "eslint"]
  },
  "performance_metrics": {
    "execution_time_ms": 0,
    "rules_processed": 0,
    "violations_found": 0,
    "violations_fixed": 0,
    "success_rate": null
  },
  "rules": {
    "universal": [
      {
        "id": "DRY",
        "rationale": "Eliminate duplicate code and logic",
        "signals": ["duplicate code", "repeated logic", "copy-paste sections"],
        "remediation": ["extract functions", "use templates", "create reusable components"]
      },
      {
        "id": "KISS",
        "rationale": "Keep interfaces minimal while maintaining full functionality behind scenes",
        "signals": ["complex user flows", "nested interfaces"],
        "remediation": ["simplify user paths", "flatten hierarchies", "hide complexity"]
      },
      {
        "id": "SOLID",
        "rationale": "Follow object-oriented design principles",
        "signals": ["monolithic functions", "tight coupling"],
        "remediation": ["split responsibilities", "use dependency injection"]
      },
      {
        "id": "complete_implementation",
        "rationale": "Never leave placeholders or TODO comments",
        "signals": ["stub functions", "missing logic", "incomplete features"],
        "remediation": ["implement all functions", "complete business logic"]
      },
      {
        "id": "double_quotes",
        "rationale": "Consistent JSON formatting",
        "signals": ["mixed quotes", "single quotes"],
        "remediation": ["use double quotes only"]
      },
      {
        "id": "two_space_indents",
        "rationale": "Standard formatting for readability",
        "signals": ["tabs present", "four-space indents"],
        "remediation": ["convert to two spaces"]
      },
      {
        "id": "input_validation",
        "rationale": "Prevent errors and security issues",
        "signals": ["unvalidated parameters", "direct interpolation"],
        "remediation": ["validate inputs", "sanitize data"]
      },
      {
        "id": "POLA",
        "rationale": "Least astonishment; predictable behavior",
        "signals": ["unexpected side effects", "surprising defaults"],
        "remediation": ["follow conventions", "predictable naming"]
      },
      {
        "id": "never_truncate",
        "rationale": "No partial implementations or ellipses",
        "signals": ["TODO ellipsis", "truncated code"],
        "remediation": ["emit complete implementations"]
      },
      {
        "id": "brevity_with_clarity",
        "rationale": "Concise without losing meaning",
        "signals": ["cryptic configs", "lost context", "unclear intent"],
        "remediation": ["retain rationale", "avoid over-compression"]
      },
      {
        "id": "preserve_context",
        "rationale": "Capture decision rationale for future cycles",
        "signals": ["missing rationale", "lost history"],
        "remediation": ["document decisions", "embed reasoning"]
      },
      {
        "id": "eliminate_duplication",
        "rationale": "Single source of truth",
        "signals": ["duplicate blocks", "redundant logic"],
        "remediation": ["consolidate", "reference canonical instance"]
      },
      {
        "id": "logical_organization",
        "rationale": "Group/order by cohesive purpose & importance",
        "signals": ["scattered related items", "random ordering"],
        "remediation": ["cluster by cohesion", "reorder by priority"]
      },
      {
        "id": "normalize",
        "rationale": "Consistent naming & formatting",
        "signals": ["mixed naming styles", "format drift"],
        "remediation": ["apply naming standard", "canonical formats"]
      },
      {
        "id": "single_run_installers",
        "rationale": "Idempotent install scripts",
        "signals": ["duplicate installations", "state conflicts"],
        "remediation": ["guard markers", "pre-flight checks"]
      },
      {
        "id": "no_external_aux_files",
        "rationale": "Self-contained specification",
        "signals": ["external file references", "fetch attempts"],
        "remediation": ["inline templates", "embed all assets"]
      }
    ],
    "technology_specific": [
      {
        "id": "rails_modern_defaults",
        "technology": "rails",
        "rationale": "Use Rails 8 features: Propshaft, Hotwire, optimized fonts",
        "signals": ["Sprockets usage", "legacy jQuery"],
        "remediation": ["enable Hotwire", "use Propshaft assets"]
      },
      {
        "id": "shell_best_practices",
        "technology": "zsh_ksh",
        "rationale": "Write readable, safe shell scripts",
        "signals": ["cryptic one-liners", "unquoted variables"],
        "remediation": ["expand to multiline", "quote variables"]
      },
      {
        "id": "html_semantic_mobile_first",
        "technology": "html_css",
        "rationale": "Use semantic HTML5 with mobile-first CSS",
        "signals": ["non-semantic markup", "desktop-first design"],
        "remediation": ["use semantic tags", "mobile-first breakpoints"]
      }
    ]
  },
  "registries": {
    "feature_packs": [
      {
        "id": "web_development",
        "rules": ["rails_modern_defaults", "html_semantic_mobile_first"],
        "standards": ["WCAG_2_2_AAA", "responsive_design", "accessibility"]
      },
      {
        "id": "security_hardening",
        "rules": ["input_validation"],
        "standards": ["zero_trust_architecture", "least_privilege"]
      }
    ]
  },
  "tools": {
    "execution_order": "sequential",
    "tools": [
      {"priority": 1, "id": "deep_execution_trace", "execution_method": "LLM_simulation_comprehensive_analysis"},
      {"priority": 2, "id": "exhaustive_validation", "execution_method": "LLM_rule_by_rule_compliance_check"},
      {"priority": 3, "id": "fresh_perspectives", "execution_method": "LLM_multi_perspective_analysis"},
      {"priority": 4, "id": "creative_alternatives", "execution_method": "LLM_creative_ideation_with_implementation"},
      {"priority": 5, "id": "gaps_pitfalls_detection", "execution_method": "LLM_systematic_gap_analysis"}
    ]
  },
  "execution_behavior": {
    "directive": "apply_all_rules_exhaustively_zero_tolerance",
    "max_iterations": 10,
    "convergence_criteria": "zero_new_violations_found",
    "resource_limits": ["30s execution time", "100MB memory", "5 recursion depth"],
    "output_format": "code_diffs_with_explanations",
    "tolerance": "zero_violations_permitted"
  },
  "validation_framework": {
    "conflict_resolution": "explicit_compatibility_annotations",
    "escalation": "human_review_for_unresolved_conflicts"
  },
  "error_recovery": {
    "syntax_errors": "attempt_auto_correction_then_fail_gracefully",
    "rule_conflicts": "use_compatibility_annotations",
    "infinite_loops": "break_loop_preserve_results"
  },
  "workflow_rules": {
    "operational": [
      {"id": "quiet_mode", "rationale": "Minimize narrative; focus on actionable diffs", "enabled_by_default": true}
    ]
  },
  "user_context": {
    "current_session": "anon987654321"
  },
  "learning_engine": {
    "pattern_recognition": "analyze_execution_logs_for_trends",
    "adaptation_triggers": ["high_failure_rate", "new_technologies", "user_feedback"],
    "safeguards": ["human_approval_required", "rollback_capability"]
  },
  "anti_patterns": {
    "brevity_traps": ["cryptic_code", "lost_context"],
    "complexity_traps": ["over_engineering", "premature_optimization"],
    "maintenance_traps": ["missing_documentation", "implicit_dependencies"]
  },
  "protected_sections": [
    "meta",
    "rules.universal",
    "rules.technology_specific",
    "tools",
    "execution_behavior",
    "workflow_rules",
    "validation_framework",
    "anti_patterns",
    "protected_sections",
    "changelog"
  ],
  "changelog": [
    {"version": "7.0.0", "summary": "Schema simplification; restored key governance rules; quiet_mode default enabled."}
  ]
}
